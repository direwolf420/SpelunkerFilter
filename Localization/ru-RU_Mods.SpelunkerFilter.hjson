Configs: {
	SFConfig: {
		DisplayName: Настройки спелеолога

		ApplyToMetalDetector: {
			Label: Применять к металлодетектору?
			Tooltip:
				'''
				Применять фильтр и для {$ItemName.MetalDetector}
				Отключите, чтобы использовать отдельные настройки фильтра на следующей странице
				'''
		}

		RemoveSparklingDust: {
			Label: Убрать сверкающие частицы?
			Tooltip: Если включено, убирает сверкающие частицы, которые появляются на подсвеченных блоках. Может увеличить производительность
		}
	}

	SFConfigMD: {
		DisplayName: Настройка металлодетектора

		OverriddenBySFConfig: {
			Label: "[c/ff0000:Используются {$Configs.SFConfig.DisplayName}?]"
			Tooltip: Означает, что функция "{$Configs.SFConfig.ApplyToMetalDetector.Label}" в "{$Configs.SFConfig.DisplayName}" включена и имеет приоритет
		}
	}

	SFConfigBase: {
		DefaultFilterTooltip: Выключите, чтобы {$ItemName.SpelunkerPotion} не подсвечивало это
		SpecialFilterTooltip: Выберите, как {$ItemName.SpelunkerPotion} будет на это влиять

		Headers: {
			CustomFilter: Личный фильтр
			PresetFilterGroupToggles: Переключатели предустановленных фильтров для групп ванильных блоков
			PresetFilter: Предустановленный фильтр для ванильных блоков
			SpecialFilter: Особый фильтр
		}

		CustomWhitelist: {
			Label: Личный белый список
			Tooltip: Блоки в этом списке БУДУТ подсвечены. Имеет приоритет над "{$Configs.SFConfigBase.Headers.PresetFilter}" и "{$Configs.SFConfigBase.CustomBlacklist.Label}"
		}

		CustomBlacklist: {
			Label: Личный чёрный список
			Tooltip: Блоки в этом списке НЕ БУДУТ подсвечены. Имеет приоритет над "{$Configs.SFConfigBase.Headers.PresetFilter}"
		}

		ToggleGems: {
			Label: Вкл./Откл. драгоценные камни
			Tooltip: Включает или отключает отображение драгоценных камней
		}

		TogglePreHMMetalOres: {
			Label: Вкл./Откл. руды до Хардмода
			Tooltip: Включает или отключает отображение всех руд до Хардмода
		}

		ToggleHMMetalOres: {
			Label: Вкл./Откл. руды Хардмода
			Tooltip: Включает или отключает отображение всех руд Хардмода
		}

		Pots.Label: Горшки
		DesertFossil.Label: Пустынные окаменелости
		FossilOre.Label: Затвердевшая окаменелость
		Copper.Label: Медная руда
		Tin.Label: Оловянная руда
		Iron.Label: Железная руда
		Lead.Label: Свинцовая руда
		Silver.Label: Серебряная руда
		Tungsten.Label: Вольфрамовая руда
		Gold.Label: Золотая руда
		Platinum.Label: Платиновая руда
		Meteorite.Label: Метеорит
		Containers.Label: Хранилища
		FakeContainers.Label: Ложные хранилища
		Containers2.Label: Хранилища 2
		FakeContainers2.Label: Ложные хранилища 2
		Heart.Label: Кристаллы жизни
		ManaCrystal.Label: Кристаллы маны
		Cobalt.Label: Кобальтовая руда
		Palladium.Label: Палладиевая руда
		Mythril.Label: Мифриловая руда
		Orichalcum.Label: Орихалковая руда
		Adamantite.Label: Адамантитовая руда
		Titanium.Label: Титановая руда
		Chlorophyte.Label: Хлорофитовая руда
		DyePlants.Label: Растения для красителей
		LifeFruit.Label: Фрукт жизни
		Sapphire.Label: Сапфир
		Ruby.Label: Рубин
		Emerald.Label: Изумруд
		Topaz.Label: Топаз
		Amethyst.Label: Аметист
		Diamond.Label: Алмазы
		MatureHerbs.Label: Зрелые травы
		BloomingHerbs.Label: Цветущие травы
		Statues.Label: Статуи
		ExposedGems.Label: Открытые драгоценные камни
		Painting3X3.Label: Картины (3x3)
		Painting6X4.Label: Картины (6x4)
		Painting2X3.Label: Картины (2x3)
		Painting3X2.Label: Картины (3x2)
		AlphabetStatues.Label: Статуя алфавита
		MushroomStatue.Label: Статуя грибов
		CatBast.Label: Статуя Бастет
		BoulderStatue.Label: Статуя валуна
		AmberStoneBlock.Label: Янтарь
		GelatinCrystal.Label: Кристалл желатина
	}

	ToggleOverride: {
		Tooltip: ""

		Default: {
			Label: Стандарт
			Tooltip: ""
		}

		Whitelist: {
			Label: Допуск
			Tooltip: ""
		}

		Blacklist: {
			Label: Запрет
			Tooltip: ""
		}
	}
}
