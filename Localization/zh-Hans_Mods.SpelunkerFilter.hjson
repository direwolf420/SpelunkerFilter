Configs: {
	SFConfig: {
		DisplayName: 洞穴探险配置

		ApplyToMetalDetector: {
			Label: 应用于{$ItemName.MetalDetector}
			Tooltip:
				'''
				若启用，将对{$ItemName.MetalDetector}应用相同的过滤设置
				若禁用，则改用下一页中独立的{$SFConfigMD.DisplayName}
				'''
		}

		RemoveSparklingDust: {
			Label: 移除闪光效果
			Tooltip: 若启用，将移除高亮物块上方出现的闪光粒子效果。可能提升性能
		}
	}

	SFConfigMD: {
		DisplayName: 金属探测器配置

		OverriddenBySFConfig: {
			Label: "[c/ff0000:被“{$Configs.SFConfig.DisplayName}”覆盖]"
			Tooltip: 若启用，表示“{$Configs.SFConfig.DisplayName}”中的“{$Configs.SFConfig.ApplyToMetalDetector.Label}”会覆盖此配置
		}
	}

	SFConfigBase: {
		DefaultFilterTooltip: 关闭此项可防止{$ItemName.SpelunkerPotion}将其高亮
		SpecialFilterTooltip: 选择一个选项，以更改{$ItemName.SpelunkerPotion}对它的影响方式

		Headers: {
			CustomFilter: 自定义
			PresetFilterGroupToggles: 预设 - 原版物块组
			PresetFilter: 预设 - 原版物块
			SpecialFilter: 特例
		}

		CustomWhitelist: {
			Label: 自定义白名单
			Tooltip: 此列表中的物块会被高亮。优先于 {$Configs.SFConfigBase.Headers.PresetFilter} 和 {$Configs.SFConfigBase.CustomBlacklist.Label}
		}

		CustomBlacklist: {
			Label: 自定义黑名单
			Tooltip: 此列表中的物块不会被高亮。高于“{$Configs.SFConfigBase.Headers.PresetFilter}”
		}

		ToggleGems: {
			Label: 切换全部宝石
			Tooltip: 切换所有宝石
		}

		TogglePreHMMetalOres: {
			Label: 困难模式前的矿石
			Tooltip: 是否高亮所有困难模式前的金属矿石
		}

		ToggleHMMetalOres: {
			Label: 切换困难模式矿石
			Tooltip: 切换所有困难模式的金属矿石
		}

		Pots.Label: 罐子
		DesertFossil.Label: 沙漠化石
		FossilOre.Label: 坚固化石
		Copper.Label: 铜矿
		Tin.Label: 锡矿
		Iron.Label: 铁矿
		Lead.Label: 铅矿
		Silver.Label: 银矿
		Tungsten.Label: 钨矿
		Gold.Label: 金矿
		Platinum.Label: 铂金矿
		Meteorite.Label: 陨石
		Containers.Label: 容器
		FakeContainers.Label: 装饰/陷阱容器
		Containers2.Label: 容器 2
		FakeContainers2.Label: 装饰/陷阱容器 2
		Heart.Label: 生命水晶
		ManaCrystal.Label: 魔力水晶
		Cobalt.Label: 钴矿
		Palladium.Label: 钯金矿
		Mythril.Label: 秘银矿
		Orichalcum.Label: 山铜矿
		Adamantite.Label: 精金矿
		Titanium.Label: 钛金矿
		Chlorophyte.Label: 叶绿矿
		DyePlants.Label: 染料植物
		LifeFruit.Label: 生命果
		Sapphire.Label: 蓝玉
		Ruby.Label: 红玉
		Emerald.Label: 翡翠
		Topaz.Label: 黄玉
		Amethyst.Label: 紫晶
		Diamond.Label: 钻石
		MatureHerbs.Label: 成熟草药
		BloomingHerbs.Label: 开花草药
		Statues.Label: 雕像
		ExposedGems.Label: 裸露宝石
		Painting3X3.Label: 绘画作品（3x3）
		Painting6X4.Label: 绘画作品（6x4）
		Painting2X3.Label: 绘画作品（2x3）
		Painting3X2.Label: 绘画作品（3x2）
		AlphabetStatues.Label: 字母雕像
		MushroomStatue.Label: 蘑菇雕像
		CatBast.Label: 巴斯特雕像
		BoulderStatue.Label: 巨石雕像
		AmberStoneBlock.Label: 琥珀
		GelatinCrystal.Label: 明胶水晶
	}

	ToggleOverride: {
		Tooltip: ""

		Default: {
			Label: 默认
			Tooltip: ""
		}

		Whitelist: {
			Label: 白名单
			Tooltip: ""
		}

		Blacklist: {
			Label: 黑名单
			Tooltip: ""
		}
	}
}
